# Copy to .env on the machine that holds the deploy key. Never commit .env.
# `source .env` before running the forge script (or `forge script --env-file`).

# ── Required ────────────────────────────────────────────────────────────────
PRIVATE_KEY=0x...                       # deployer EOA; only pays gas, holds no role afterwards
RPC_URL=https://rpc.mainnet.chain.robinhood.com  # Robinhood Chain (chain id 4663)
EXPECTED_CHAIN_ID=4663                  # required; the script aborts if the RPC reports a different chain

USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
UNISWAP_POSITION_MANAGER=0x73991a25c818bf1f1128deaab1492d45638de0d3

# FeeVault multisig: comma-separated signer addresses and the threshold (>= 2).
# Keep the threshold BELOW the signer count: with every signer required, one
# lost key locks the vault forever and there is no signer rotation. The script
# refuses threshold == count unless ALLOW_FULL_THRESHOLD=true is set.
VAULT_OWNERS=0x...,0x...,0x...
VAULT_THRESHOLD=2
# ALLOW_FULL_THRESHOLD=false

# ── Optional overrides (defaults shown) ─────────────────────────────────────
# UNISWAP_V3_FACTORY=                   # default: positionManager.factory()
# USDG_DECIMALS=6                       # default: USDG.decimals()
# LP_PROTOCOL_FEE_SHARE_BPS=3000        # protocol share of locked-LP fees (max 5000)
# POOL_FEE=10000                        # Uniswap v3 fee tier for graduated pools (1%)
# POOL_TICK_SPACING=200                 # tick spacing of that tier

# Curve parameters — whole units, the script scales by token/USDG decimals.
# The virtual reserves are NOT configurable: the factory derives both from the
# allocations and the target so the pool opens at the curve's closing price
# (vU = lpAllocation * target / (curve - lpAllocation) = 23,000 USDG with these
# defaults). CURVE_ALLOCATION must exceed half of TOTAL_SUPPLY.
# TOTAL_SUPPLY=1000000000
# CURVE_ALLOCATION=800000000
# GRADUATION_TARGET_USDG=69000
# GRADUATION_FEE_USDG=0
# CREATION_FEE_USDG=1
# TRADE_FEE_BPS=100
# CREATOR_FEE_SHARE_BPS=7000
# DEV_BUY_MAX_BPS=500
# SNIPE_BLOCKS=3
# SNIPE_MAX_BPS=100

# ── Verification (Blockscout) ───────────────────────────────────────────────
VERIFIER_URL=https://robinhoodchain.blockscout.com/api/
