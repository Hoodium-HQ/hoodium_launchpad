# Build output — regenerated by `forge build`, never reviewed, and large.
out/
cache/
broadcast/

# Deployment artefacts can contain RPC URLs with embedded API keys.
broadcast/**/dry-run/

# Secrets. A contract repo has no business holding a key: deployment reads
# PRIVATE_KEY from the environment (see script/Deploy.s.sol).
.env
.env.*
!.env.example

docs/
node_modules/

# Anvil rehearsal artefacts; keep only real-chain broadcast records
broadcast/*/31337/
