# Hoodium Launchpad web — configuration
#
# Only VITE_-prefixed variables reach the browser, and everything here is public
# by definition. No private key, seed phrase, or session key ever appears in
# frontend configuration or storage.

# Launchpad API + indexer.
VITE_API_URL=http://127.0.0.1:8080

# Canonical origin, used for share links and metadata.
VITE_SITE_URL=http://localhost:5173

# Chain identity. No defaults: the app refuses to render trading surfaces on a
# mismatch, and a build that does not state its chain does not build.
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Anvil
VITE_RPC_URL=http://127.0.0.1:8545
VITE_EXPLORER_URL=http://127.0.0.1:8545

# Quote asset (USDG, 6 decimals). The address is what the trade panel approves.
VITE_QUOTE_SYMBOL=USDG
VITE_QUOTE_DECIMALS=6
VITE_QUOTE_ADDRESS=

# Launchpad contracts. Leave empty until the owner deploys them: an empty
# factory disables the launch form and says so; explore and profiles still
# work. VITE_LOCKER is optional — it is discoverable on-chain from the factory.
# VITE_FEE_VAULT is shown, never called.
VITE_LAUNCHPAD_FACTORY=
VITE_LOCKER=
VITE_FEE_VAULT=
# Optional. GraduationHelper: when a buy that would complete the curve is
# blocked by a hostilely primed pool, the trade panel offers to fix the pool
# price and buy in one transaction through it. Empty = the offer is not shown.
VITE_GRADUATION_HELPER=

# Reown AppKit — required. AppKit renders the whole connect surface and will not
# construct without a project id. Free id from https://dashboard.reown.com; the
# deployment's origin has to be on that project's allowed-domains list.
VITE_REOWN_PROJECT_ID=
