{
  "name": "hoodium-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hoodium Auto LP backend — spec 001, phases 1-3 (read-only)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "kill-switch": "tsx src/scripts/kill-switch.ts",
    "chain:local": "npx --yes ganache --chain.chainId 31337 --port 8545 --wallet.deterministic --miner.blockTime 2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@hoodium/shared": "github:Hoodium-HQ/hoodium_shared#v0.1.1",
    "@sentry/node": "^8.42.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "mongoose": "^8.9.2",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "viem": "^2.21.55",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
