{
  "name": "hoodium-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hoodium worker — indexer, monitor, alerting. Runs exactly once (spec 001).",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "start": "node dist/worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hoodium/core": "github:Hoodium-HQ/hoodium_core#v0.1.4",
    "@hoodium/shared": "github:Hoodium-HQ/hoodium_shared#v0.1.3",
    "decimal.js": "^10.4.3",
    "mongoose": "^8.9.2",
    "viem": "^2.21.55",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
