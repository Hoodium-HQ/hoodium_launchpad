# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=https://launchpad.hoodium.app
# Where the launchpad web app lives (used in links / share metadata).
APP_ORIGIN=https://launchpad.hoodium.app

# ── Storage ─────────────────────────────────────────────────────────────────
# Database name defaults to hoodium_launchpad when the URI names none.
MONGO_URI=mongodb://localhost:27017/hoodium_launchpad

# ── Chain ───────────────────────────────────────────────────────────────────
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# Leave empty (or 0x000…) until the contracts are deployed: the indexer idles and
# the API serves empty lists instead of crashing.
LAUNCHPAD_FACTORY=
USDG_ADDRESS=0x0000000000000000000000000000000000000000
USDG_DECIMALS=6

# ── Indexer ─────────────────────────────────────────────────────────────────
INDEXER_ENABLED=true
INDEXER_POLL_MS=4000
# First block to scan when no cursor exists yet (the factory's deploy block).
INDEXER_START_BLOCK=0
# Widest getLogs window the RPC will serve (Robinhood public RPC caps this).
GETLOGS_MAX_RANGE=2000
# Confirmations before a trade is marked finalized, and how many recent block
# headers are kept to detect reorgs.
INDEXER_CONFIRMATIONS=32
INDEXER_REORG_BUFFER_BLOCKS=64

# ── IPFS ────────────────────────────────────────────────────────────────────
# Optional. Without it POST /api/metadata answers 503.
PINATA_JWT=
PINATA_API_URL=https://api.pinata.cloud
IPFS_GATEWAY_URL=https://gateway.pinata.cloud
